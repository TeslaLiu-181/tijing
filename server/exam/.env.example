# 本机预览；正式部署填写实际 HTTPS 入口（支持已签发证书的域名或 IP）。
EXAM_HOST=127.0.0.1
EXAM_PORT=8080
EXAM_PUBLIC_URL=http://127.0.0.1:8080
EXAM_CLASS_NAME=物理学习空间
EXAM_USER_QUOTA_MB=500
EXAM_MAX_RESOURCES=200
# 可选：指定持久数据目录；默认位于程序目录 data/exam-web。
# EXAM_DATA_DIR=/var/lib/tijing

# API Key 优先在教师页面的“API设置”配置；学生可独立保存个人配置。
# 以下是共享连接的初始值。不要将真实密钥写入版本库或分发包。
# EXAM_AI_ENV_FILE=/etc/tijing/ai.env
# EXAM_AI_API_KEY=
# EXAM_AI_BASE_URL=https://api.deepseek.com/v1
# EXAM_AI_MODEL=deepseek-flash
# EXAM_AI_VISION_MODEL=deepseek-flash
# EXAM_AI_JSON_FORMAT=true
# EXAM_AI_MAX_TOKENS=16384
# EXAM_AI_REVIEW_MAX_TOKENS=16384
# EXAM_AI_TIMEOUT_MS=120000
# EXAM_AI_REVIEW_TIMEOUT_MS=180000
# EXAM_AI_JOB_TIMEOUT_MS=600000
# EXAM_AI_PARALLEL=2
# EXAM_AI_DAILY_STUDENT=30
# EXAM_AI_DAILY_TEACHER=100
# EXAM_AI_DAILY_TOTAL=300
# EXAM_AI_DAILY_TOKEN_STUDENT=150000
# EXAM_AI_DAILY_TOKEN_TEACHER=500000
# EXAM_AI_DAILY_TOKEN_TOTAL=2000000

# Official WeChat website login; keep disabled until app/domain approval and testing.
EXAM_WECHAT_ENABLED=0
# EXAM_WECHAT_APP_ID=
# EXAM_WECHAT_APP_SECRET=
# EXAM_WECHAT_REDIRECT_URI=https://your-approved-domain.example/api/auth/wechat/callback
